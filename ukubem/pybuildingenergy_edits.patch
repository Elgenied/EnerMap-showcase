+def _annual_hour_positions(index) -> np.ndarray:
+    """
+    Position (0..8759) of every timestamp of a simulation horizon inside a calendar-year
+    hourly array, by day-of-year and hour. Leap days are folded so that a 8760-long
+    series also serves leap-year horizons; the December warm-up month that precedes the
+    simulated year maps onto the December values of the same series.
+    """
+    dt = pd.DatetimeIndex(index)
+    doy = dt.dayofyear.to_numpy() - np.where(dt.is_leap_year & (dt.month > 2), 1, 0)
+    return np.clip((doy - 1) * 24 + dt.hour.to_numpy(), 0, 8759)
+
+
+def _align_annual_series_to_index(values, index) -> np.ndarray:
+    """Map a calendar-year hourly series (8760 or 8784 values) onto a simulation index."""
+    a = np.asarray(values, dtype=float).reshape(-1)
+    if a.size == 8784:                                   # leap-year series: drop 29 February
+        a = np.delete(a, np.arange(59 * 24, 60 * 24))
+    return a[_annual_hour_positions(index)]
+
+
+def _apply_hourly_profile_override(building_object, profile_df):
+    """
+    UBEM extension. If `building_parameters["hourly_profiles"]` holds calendar-year hourly
+    arrays keyed by category ("heating", "cooling", "ventilation", "occupancy", "lighting",
+    "appliances"; with or without the "_profile" suffix), replace the corresponding
+    weekday/weekend-generated columns of `profile_df` with those values, aligned to the
+    simulation horizon by day-of-year and hour. Categories not supplied keep the daily profiles.
+    """
+    bp = building_object.get("building_parameters") or {}
+    hourly = bp.get("hourly_profiles")
+    if not hourly:
+        return profile_df
+    if "datetime" in profile_df.columns:
+        idx = pd.DatetimeIndex(profile_df["datetime"])
+    else:
+        idx = pd.DatetimeIndex(profile_df.index)
+    out = profile_df.copy()
+    for cat, values in hourly.items():
+        col = cat if str(cat).endswith("_profile") else f"{cat}_profile"
+        arr = np.asarray(values, dtype=float).reshape(-1)
+        if arr.size not in (8760, 8784):
+            raise ValueError(f"hourly_profiles['{cat}'] must hold 8760 (or 8784) hourly values, got {arr.size}")
+        out[col] = _align_annual_series_to_index(arr, idx)
+    return out
+
